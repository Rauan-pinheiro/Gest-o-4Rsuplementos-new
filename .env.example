# Copie este arquivo para ".env" e preencha com valores reais.
# O ".env" nunca deve ser commitado (ja esta no .gitignore).

# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=seu-dominio.com.br,www.seu-dominio.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-dominio.com.br,https://www.seu-dominio.com.br

# --- Banco de dados (Postgres) ---
POSTGRES_DB=suplementos
POSTGRES_USER=suplementos
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Superusuario (unico login do sistema, criado automaticamente no deploy) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=voce@exemplo.com
DJANGO_SUPERUSER_PASSWORD=troque-por-uma-senha-forte

# --- Dominio publico (usado pelo Caddy para emitir HTTPS automatico) ---
SITE_DOMAIN=seu-dominio.com.br
