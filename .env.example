# Copie este arquivo para ".env" e preencha com valores reais.
# O ".env" nunca deve ser commitado (ja esta no .gitignore).

# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=seu-dominio.com.br,www.seu-dominio.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-dominio.com.br,https://www.seu-dominio.com.br
DJANGO_LOG_LEVEL=INFO

# --- Banco de dados (Postgres) ---
# Duas formas suportadas (o projeto detecta automaticamente qual usar):
#
# 1) DATABASE_URL — usada na Railway (o plugin de Postgres da Railway já cria
#    essa variável sozinho quando você conecta o banco ao serviço web; não
#    precisa preencher a mão). Formato: postgres://usuario:senha@host:porta/nome
# DATABASE_URL=
#
# 2) POSTGRES_* — usada no VPS/docker-compose (ver docker-compose.yml). Só é
#    lida se DATABASE_URL não estiver definida.
POSTGRES_DB=suplementos
POSTGRES_USER=suplementos
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Superusuario (unico login do sistema, criado automaticamente no deploy) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=voce@exemplo.com
DJANGO_SUPERUSER_PASSWORD=troque-por-uma-senha-forte

# --- Dominio publico (usado pelo Caddy para emitir HTTPS automatico num VPS) ---
# Na Railway não é necessário — a plataforma cuida de HTTPS e domínio sozinha,
# e o domínio *.up.railway.app é detectado automaticamente (RAILWAY_PUBLIC_DOMAIN).
SITE_DOMAIN=seu-dominio.com.br

# --- Porta (Railway injeta PORT automaticamente; não precisa definir aqui) ---
# PORT=8000
